{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run build && npm ci --prefix server --omit=dev"
  },
  "deploy": {
    "startCommand": "node --max-old-space-size=64 --max-semi-space-size=2 server/index.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "sleepApplication": true
  }
}
